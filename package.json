{
  "name": "leyra-seguridad-desktop",
  "version": "1.0.1",
  "description": "Aplicación de escritorio para la gestión de servicios de Leyra Seguridad",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "server": "node server.js",
    "test:server": "node --test tests/server.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "socket.io-client": "^4.8.4"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "build": {
    "appId": "com.leyra.seguridad",
    "productName": "Leyra Seguridad",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "installer-build"
    },
    "files": [
      "main.js",
      "*.html",
      "css/**",
      "js/**",
      "assets/**",
      "!tests/**",
      "!server.js",
      "!render.yaml",
      "!.env*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://leyra-seguridad-api.onrender.com/updates/"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Leyra Seguridad"
    }
  }
}
